{
  "name": "ddd-core-ts",
  "version": "0.1.1",
  "description": "TypeScript building blocks for Domain-Driven Design — entities, value objects, use cases, domain errors, domain events, and more.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Stephen Horvath",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asciiman/ddd-core-ts.git"
  },
  "homepage": "https://github.com/asciiman/ddd-core-ts#readme",
  "bugs": {
    "url": "https://github.com/asciiman/ddd-core-ts/issues"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "entity",
    "value-object",
    "use-case",
    "domain-events",
    "typescript"
  ],
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --passWithNoTests",
    "clean": "rm -rf dist coverage node_modules"
  },
  "dependencies": {
    "shallow-equal-object": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.3",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
