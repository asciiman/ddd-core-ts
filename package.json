{
  "name": "ddd-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "UNLICENSED",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --passWithNoTests",
    "clean": "rm -rf dist coverage node_modules"
  },
  "dependencies": {
    "shallow-equal-object": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.3",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
